# =====================================================================
# Finance Operations Management System (FOMS) & AI Intelligence Layer
# Local & CI/CD Environment Configuration Template (.env.example)
# =====================================================================
# IMPORTANT:
# 1. DO NOT commit actual secrets, API keys, or production passwords here.
# 2. Copy this template to .env for local development:
#    cp .env.example .env
# =====================================================================

# ASP.NET Core Web API / Backend Service
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
PORT=5000

# Microsoft SQL Server (Official FOMS Source of Truth)
MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_DATABASE=FOMS_DB
MSSQL_DB=FOMS_DB
MSSQL_TRUSTED_CONNECTION=True
MSSQL_TRUST_SERVER_CERTIFICATE=True
MSSQL_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=FOMS_DB;Trusted_Connection=True;TrustServerCertificate=True;
ConnectionStrings__FomsSqlServer=Server=localhost\SQLEXPRESS;Database=FOMS_DB;Trusted_Connection=True;TrustServerCertificate=True;
ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=FOMS_DB;Trusted_Connection=True;TrustServerCertificate=True;

# JWT Security & Service Authentication
JWT_SECRET=your-local-jwt-secret-minimum-32-chars-long-here
JWT_ISSUER=FOMS
JWT_AUDIENCE=FOMS_USERS
JWT_EXPIRES_MINUTES=120
FOMS_JWT_ISSUER=FOMS
FOMS_JWT_AUDIENCE=FOMS_USERS

# PostgreSQL & pgAdmin (AI Output & Analytics Store)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=foms_ai_results
POSTGRES_DB=foms_ai_results
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-joo
POSTGRES_CONNECTION_STRING=postgresql://your-postgres-user:your-postgres-joo@localhost:5432/foms_ai_results

# MongoDB (AI Telemetry & Trends Store)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=foms_trends_db
MONGO_DB=foms_trends_db

# Google Gemini API & Document AI Provider
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL_NAME=gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=your-ai-service-internal-key

# PayMongo & SpeedPay Gateway Integration
PAYMONGO_SECRET_KEY=your-paymongo-secret-key
PAYMONGO_PUBLIC_KEY=your-paymongo-public-key
PAYMONGO_WEBHOOK_SECRET=your-paymongo-webhook-secret
SPEEDPAY_API_BASE_URL=http://localhost:5174
VITE_SPEEDPAY_API_URL=http://localhost:4000
VITE_SPEEDPAY_APP_URL=http://localhost:5174

# Core APIs & CORS Bindings
FOMS_API_URL=http://localhost:5007
FOMS_READ_API_URL=http://localhost:5007
VITE_API_URL=http://localhost:5007
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:4173,http://localhost:3000

# File Upload & Document Validation Constraints
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Feature Flags & Strict Database Mode
ENABLE_SPEEDPAY=true
ENABLE_AI_SCAN=true
ENABLE_DOCUMENT_EXTRACTION=true
ENABLE_MOCK_DATA=false
ENABLE_SEED_FALLBACK=false
# Inserts duplicate-review demo records during duplicate API reads; keep false outside demo environments.
ENABLE_DUPLICATE_SAMPLE_DATA=false
