# =====================================================================
# Finance Operations Management System (FOMS) & AI Intelligence Layer
# Complete System Environment Configuration (.env)
# =====================================================================

# ---------------------------------------------------------------------
# 1. Microsoft SQL Server (Official Source of Truth - Local SQLEXPRESS)
# ---------------------------------------------------------------------
# Primary relational database for transactional FOMS records
MSSQL_SERVER=localhost\SQLEXPRESS
MSSQL_DB=FOMS_DB
MSSQL_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=FOMS_DB;Trusted_Connection=True;TrustServerCertificate=True;
ConnectionStrings__FomsSqlServer=Server=localhost\SQLEXPRESS;Database=FOMS_DB;Trusted_Connection=True;TrustServerCertificate=True;
ConnectionStrings__DefaultConnection=Server=localhost\SQLEXPRESS;Database=FOMS_DB;Trusted_Connection=True;TrustServerCertificate=True;

# ---------------------------------------------------------------------
# 2. PostgreSQL & pgAdmin 4 (AI Decision Support & Analytics - Docker)
# ---------------------------------------------------------------------
# Analytical store for AI OCR extractions, duplicate detection, and risk scoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Postgres2026!
POSTGRES_DB=foms_ai_results
POSTGRES_PORT=5432
POSTGRES_CONNECTION_STRING=postgresql://postgres:Postgres2026!@localhost:5432/foms_ai_results

PGADMIN_DEFAULT_EMAIL=admin@foms.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# ---------------------------------------------------------------------
# 3. MongoDB (Time-Series Metrics & Activity Trends - Docker)
# ---------------------------------------------------------------------
# Document store for telemetry, trend metrics, and audit time-series
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=mongo_password_2026
MONGO_DB=foms_trends_db
MONGO_PORT=27017
MONGODB_URI=mongodb://root:mongo_password_2026@localhost:27017/foms_trends_db?authSource=admin

# ---------------------------------------------------------------------
# 4. Google Gemini API (Document OCR, Classification & Analysis)
# ---------------------------------------------------------------------
# Google Gemini API key and model selection
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_PROJECT_NAME=projects/251591146809
GOOGLE_PROJECT_NUMBER=251591146809

# ---------------------------------------------------------------------
# 5. Core FOMS API & AI Microservice Configuration
# ---------------------------------------------------------------------
# Core backend Web API (.NET 10)
FOMS_READ_API_URL=http://localhost:5007
FOMS_API_URL=http://localhost:5007
VITE_API_URL=http://localhost:5007

# AI Integration Gateway & Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=foms-secret-key-2026
FOMS_AI_SERVICE_API_KEY=foms-secret-key-2026
SYNC_INTERVAL_MINUTES=10

# ---------------------------------------------------------------------
# 6. Payment Gateway Configuration (PayMongo / SpeedPay Portal)
# ---------------------------------------------------------------------
PAYMONGO_SECRET_KEY=sk_test_fyNzfY2nbwdhfgUcoMmWoZJq
VITE_PAYMONGO_SECRET_KEY=sk_test_fyNzfY2nbwdhfgUcoMmWoZJq
PAYMONGO_WEBHOOK_SECRET=whsk_your_webhook_secret_here
SPEEDPAY_USERNAME=test-001
SPEEDPAY_PASSWORD=password123
VITE_SPEEDPAY_API_URL=http://localhost:4000
VITE_SPEEDPAY_APP_URL=http://localhost:5174

# ---------------------------------------------------------------------
# 7. JWT Security & Service Authentication
# ---------------------------------------------------------------------
JWT_SECRET=FOMS_Capstone_JWT_SecureKey_2026!!
JWT_ISSUER=FOMS.Api
JWT_AUDIENCE=FOMS.Api
FOMS_JWT_ISSUER=FOMS.Api
FOMS_JWT_AUDIENCE=FOMS.Api
SERVICE_JWT_SECRET=foms-service-secret-2026
SERVICE_API_KEY=foms-service-api-key-2026

# ---------------------------------------------------------------------
# 8. Rate Limiting & Audit Logging
# ---------------------------------------------------------------------
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_UPLOAD=10/minute
AUDIT_RETENTION_YEARS=5
LOG_ROTATION_MAX_SIZE_MB=100
LOG_ROTATION_DAILY=true

# ---------------------------------------------------------------------
# 9. CORS & Web Server Bindings
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:4173,http://localhost:3000,http://localhost:80,http://localhost
PORT=80
